<section class="section section-dark">
  <div class="section-inner section-narrow reveal">
    <h2 class="section-title section-center">亲自试试</h2>
    <p class="section-desc section-center" style="margin:0 auto 0">粘贴你的 Solidity 代码，观看 AuditAI 实时检测漏洞。</p>
    <div class="analyzer-layout">
      <div class="analyzer-input">
        <div class="analyzer-input-header">
          <span>📝 Solidity 代码</span>
        </div>
        <textarea class="analyzer-textarea" id="analyzerCode" placeholder="// 粘贴你的 Solidity 合约代码...
contract MyContract {
    mapping(address => uint) balances;
    
    function withdraw() public {
        uint amount = balances[msg.sender];
        (bool ok, ) = msg.sender.call{value: amount}("");
        require(ok);
        balances[msg.sender] = 0;
    }
}">contract VulnerableBank {
    mapping(address => uint256) public balances;

    function deposit() public payable {
        balances[msg.sender] += msg.value;
    }

    function withdraw() public {
        uint256 amount = balances[msg.sender];
        (bool ok, ) = msg.sender.call{value: amount}("");
        require(ok);
        balances[msg.sender] = 0;
    }

    function setOwner(address newOwner) public {
        owner = newOwner;
    }
}</textarea>
        <button class="analyzer-btn" id="analyzeBtn">🔍 分析合约</button>
      </div>
      <div class="analyzer-results" id="analyzerResults">
        <div class="analyzer-empty">点击“分析合约”查看结果</div>
      </div>
    </div>
  </div>
</section>

