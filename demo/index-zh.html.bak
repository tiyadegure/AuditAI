<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="AuditAI：5层AI代理，检测、验证、修补、链上证明 — 全自动完成。ETH Beijing 2026 构建。">
<meta property="og:title" content="AuditAI — 智能合约安全，重新定义">
<meta property="og:description" content="5层AI代理，检测、验证、修补、链上证明 — 全自动完成。">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0066cc">
<title>AuditAI — 智能合约安全，重新定义</title>
<link rel="icon" type="image/svg+xml" href="assets/logo-icon.svg">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
/* ── Reset & Variables ───────────────────────────────────── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --primary:#0066cc;
  --primary-focus:#0071e3;
  --primary-on-dark:#2997ff;
  --ink:#1d1d1f;
  --ink-muted:#86868b;
  --body-on-dark:#ffffff;
  --canvas:#ffffff;
  --canvas-parchment:#f5f5f7;
  --surface-dark:#272729;
  --surface-darker:#1a1a1c;
  --surface-black:#000000;
  --pill:9999px;
  --radius-lg:18px;
  --radius-md:12px;
  --radius-sm:8px;
  --section-pad:80px;
  --max-w:1200px;
  --max-w-narrow:980px;
  --hairline:rgba(0,0,0,.08);
  --shadow:rgba(0,0,0,0.08) 0 2px 12px;
  --shadow-lg:rgba(0,0,0,0.12) 0 8px 32px;
  --font:'Inter','Noto Sans SC',system-ui,-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;
  --font-mono:'SF Mono','Fira Code','Cascadia Code','Courier New',monospace;
}

html{scroll-behavior:smooth}
body{font-family:var(--font);color:var(--ink);background:var(--canvas);line-height:1.5;font-size:17px;letter-spacing:-0.02em;-webkit-font-smoothing:antialiased}

/* ── Navigation ──────────────────────────────────────────── */
.nav{position:fixed;top:0;left:0;right:0;z-index:1000;height:64px;background:rgba(255,255,255,.85);backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid var(--hairline);display:flex;align-items:center;justify-content:space-between;padding:0 32px;transition:background .3s}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink);font-weight:700;font-size:18px;letter-spacing:-0.3px}
.nav-logo svg{width:28px;height:28px}
.nav-links{display:flex;gap:32px;align-items:center}
.nav-links a{color:var(--ink);font-size:14px;font-weight:500;text-decoration:none;transition:color .2s}
.nav-links a:hover{color:var(--primary)}
.nav-cta{background:var(--primary);color:#fff!important;padding:8px 20px;border-radius:var(--pill);font-weight:600;transition:transform .15s,background .2s}
.nav-cta:hover{background:var(--primary-focus);transform:scale(1.02)}
.nav-cta:active{transform:scale(0.97)}

/* ── Sections ────────────────────────────────────────────── */
.section{padding:var(--section-pad) 32px}
.section-inner{max-width:var(--max-w);margin:0 auto}
.section-narrow{max-width:var(--max-w-narrow)}
.section-dark{background:var(--surface-dark);color:var(--body-on-dark)}
.section-darker{background:var(--surface-darker);color:var(--body-on-dark)}
.section-parchment{background:var(--canvas-parchment)}
.section-center{text-align:center}

/* ── Typography ──────────────────────────────────────────── */
.hero-title{font-size:clamp(36px,5vw,64px);font-weight:700;line-height:1.05;letter-spacing:-0.04em;margin-bottom:20px}
.hero-subtitle{font-size:clamp(18px,2.5vw,24px);font-weight:400;line-height:1.4;color:var(--ink-muted);max-width:640px;margin:0 auto 40px}
.section-title{font-size:clamp(28px,3.5vw,48px);font-weight:700;line-height:1.1;letter-spacing:-0.03em;margin-bottom:16px}
.section-desc{font-size:18px;line-height:1.6;color:var(--ink-muted);max-width:640px}
.section-dark .section-desc{color:rgba(255,255,255,.7)}

/* ── Buttons ─────────────────────────────────────────────── */
.btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 28px;border-radius:var(--pill);font-size:16px;font-weight:600;text-decoration:none;transition:transform .15s,background .2s,box-shadow .2s;border:none;cursor:pointer;font-family:var(--font);gap:8px}
.btn-primary{background:var(--primary);color:#fff;box-shadow:0 2px 8px rgba(0,102,204,.25)}
.btn-primary:hover{background:var(--primary-focus);box-shadow:0 4px 16px rgba(0,102,204,.35);transform:translateY(-1px)}
.btn-primary:active{transform:translateY(0) scale(0.98)}
.btn-outline{background:transparent;color:var(--primary);border:1.5px solid var(--primary)}
.btn-outline:hover{background:var(--primary);color:#fff}
.btn-ghost{background:transparent;color:var(--primary);padding:8px 0;border-radius:0}
.btn-ghost:hover{color:var(--primary-focus)}
.btn-ghost::after{content:'→';margin-left:4px;transition:transform .2s}
.btn-ghost:hover::after{transform:translateX(4px)}
.btn-white{background:#fff;color:var(--primary);box-shadow:0 2px 8px rgba(0,0,0,.1)}
.btn-white:hover{box-shadow:0 4px 16px rgba(0,0,0,.15);transform:translateY(-1px)}
.btn-row{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}

/* ── Hero ────────────────────────────────────────────────── */
.hero{padding-top:calc(120px + 64px);padding-bottom:80px;background:linear-gradient(180deg,#fff 0%,var(--canvas-parchment) 100%);position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(ellipse at 30% 20%,rgba(0,102,204,.06) 0%,transparent 50%),radial-gradient(ellipse at 70% 80%,rgba(0,102,204,.04) 0%,transparent 50%);animation:heroGlow 8s ease-in-out infinite alternate;pointer-events:none}
@keyframes heroGlow{0%{transform:translate(0,0) rotate(0deg)}100%{transform:translate(-2%,3%) rotate(2deg)}}
.hero .section-inner{position:relative;z-index:1}
.hero-badge{display:inline-flex;align-items:center;gap:8px;padding:6px 16px;background:rgba(0,102,204,.08);color:var(--primary);border-radius:var(--pill);font-size:13px;font-weight:600;margin-bottom:24px}
.hero-badge::before{content:'';width:6px;height:6px;background:var(--primary);border-radius:50%}

/* ── Stats Row ───────────────────────────────────────────── */
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;padding:48px 0;border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline);margin-top:64px}
.stat{text-align:center}
.stat-value{font-size:clamp(28px,3vw,40px);font-weight:700;color:var(--primary);margin-bottom:4px}
.stat-label{font-size:14px;color:var(--ink-muted)}

/* ── Terminal ────────────────────────────────────────────── */
.terminal-wrapper{max-width:720px;margin:48px auto 0;position:relative}
.terminal{background:var(--surface-darker);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-lg)}
.terminal-header{display:flex;align-items:center;gap:8px;padding:14px 18px;background:rgba(0,0,0,.3);border-bottom:1px solid rgba(255,255,255,.05)}
.terminal-dot{width:12px;height:12px;border-radius:50%}
.terminal-dot-r{background:#ff5f57}
.terminal-dot-y{background:#febc2e}
.terminal-dot-g{background:#28c840}
.terminal-title{flex:1;text-align:center;font-size:12px;color:rgba(255,255,255,.4);font-family:var(--font-mono)}
.terminal-body{padding:20px;font-family:var(--font-mono);font-size:13px;line-height:1.7;min-height:300px;color:#e0e0e0}
.terminal-line{opacity:0;transform:translateY(6px);transition:opacity .3s,transform .3s}
.terminal-line.visible{opacity:1;transform:translateY(0)}
.t-cmd{color:#28c840}
.t-info{color:var(--primary-on-dark)}
.t-dim{color:#6e6e73}
.t-ok{color:#28c840}
.t-warn{color:#febc2e}
.cursor{display:inline-block;width:7px;height:14px;background:var(--primary-on-dark);animation:blink 1s infinite;vertical-align:middle;margin-left:2px}
@keyframes blink{0%,50%{opacity:1}51%,100%{opacity:0}}
.btn-report{position:absolute;bottom:20px;right:20px;display:none;padding:8px 18px;background:var(--primary);color:#fff;border:none;border-radius:var(--pill);font-size:13px;font-weight:600;cursor:pointer;font-family:var(--font);transition:transform .15s,opacity .3s;opacity:0}
.btn-report.visible{display:block;opacity:1}
.btn-report:hover{transform:scale(1.05)}

/* ── Feature Grid ────────────────────────────────────────── */
.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px}
.feature-card{background:var(--canvas);border:1px solid var(--hairline);border-radius:var(--radius-lg);padding:32px;transition:box-shadow .3s,transform .3s}
.feature-card:hover{box-shadow:0 4px 24px rgba(0,102,204,.12);transform:translateY(-4px);border-color:rgba(0,102,204,.15)}
.feature-icon{width:48px;height:48px;background:rgba(0,102,204,.08);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:20px}
.feature-title{font-size:18px;font-weight:600;margin-bottom:8px}
.feature-desc{font-size:14px;color:var(--ink-muted);line-height:1.6}

/* ── Metric Cards ────────────────────────────────────────── */
.metric-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px}
.metric-card{background:var(--canvas);border:1px solid var(--hairline);border-radius:var(--radius-lg);padding:40px;text-align:center;transition:box-shadow .3s}
.metric-card:hover{box-shadow:0 4px 24px rgba(0,102,204,.12);border-color:rgba(0,102,204,.15)}
.metric-value{font-size:56px;font-weight:700;color:var(--primary);line-height:1;margin-bottom:8px}
.metric-label{font-size:14px;color:var(--ink-muted);font-weight:500}

/* ── Code Cards ──────────────────────────────────────────── */
.code-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:48px}
.code-card{background:var(--canvas);border:1px solid var(--hairline);border-radius:var(--radius-lg);overflow:hidden;transition:box-shadow .3s}
.code-card:hover{box-shadow:0 4px 24px rgba(0,102,204,.12);border-color:rgba(0,102,204,.15)}
.code-header{display:flex;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid var(--hairline)}
.code-icon{font-size:28px}
.code-title{font-size:16px;font-weight:600}
.code-stats{display:flex;gap:12px;margin-left:auto}
.code-stat{display:flex;align-items:center;gap:4px;font-size:12px;font-weight:600}
.code-stat-pass{color:#28c840}
.code-stat-fail{color:#ff5f57}
.code-stat-timeout{color:#febc2e}
.code-body{padding:20px;font-family:var(--font-mono);font-size:13px;line-height:1.6;background:var(--surface-darker);color:#e0e0e0;overflow-x:auto;white-space:pre;position:relative}
.code-body .kw{color:#c792ea}
.code-body .fn{color:#82aaff}
.code-body .tp{color:#ffcb6b}
.code-body .str{color:#c3e88d}
.code-body .num{color:#f78c6c}
.code-body .cm{color:#6e6e73;font-style:italic}
.code-body .op{color:#89ddff}

/* ── Attestation Table ───────────────────────────────────── */
.attestation{margin-top:48px;background:var(--canvas);border:1px solid var(--hairline);border-radius:var(--radius-lg);overflow:hidden}
.att-row{display:grid;grid-template-columns:200px 1fr;padding:14px 24px;border-bottom:1px solid var(--hairline);font-size:14px;transition:background .2s}
.att-row:last-child{border-bottom:none}
.att-row:hover{background:var(--canvas-parchment)}
.att-key{color:var(--ink-muted);font-weight:500}
.att-value{font-family:var(--font-mono);font-size:13px}

/* ── Knowledge Search ────────────────────────────────────── */
.knowledge-layout{display:grid;grid-template-columns:1fr 1fr;gap:48px;margin-top:48px;align-items:start}
.search-box{position:relative}
.search-input{width:100%;padding:14px 20px 14px 44px;border:1.5px solid var(--hairline);border-radius:var(--pill);font-size:15px;font-family:var(--font);outline:none;transition:border-color .2s,box-shadow .2s;background:var(--canvas)}
.search-input:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(0,102,204,.1)}
.search-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:18px;color:var(--ink-muted)}
.search-results{margin-top:12px;display:flex;flex-direction:column;gap:8px}
.search-result{background:var(--canvas);border:1px solid var(--hairline);border-radius:var(--radius-md);padding:14px;opacity:0;transform:translateY(8px);transition:opacity .4s,transform .4s}
.search-result.visible{opacity:1;transform:translateY(0)}
.search-result-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.search-result-type{font-size:11px;font-weight:600;color:var(--primary);background:rgba(0,102,204,.08);padding:2px 8px;border-radius:var(--pill)}
.search-result-score{font-size:11px;color:var(--ink-muted)}
.search-result-text{font-size:13px;line-height:1.5;color:var(--ink)}

/* ── Testimonial ─────────────────────────────────────────── */
.testimonial{max-width:640px;margin:0 auto;text-align:center;padding:64px 0}
.testimonial-quote{font-size:21px;font-weight:400;line-height:1.6;color:var(--ink);margin-bottom:24px;font-style:italic}
.testimonial-author{font-size:14px;font-weight:600;color:var(--ink)}
.testimonial-role{font-size:13px;color:var(--ink-muted)}

/* ── Footer ──────────────────────────────────────────────── */
.footer{padding:64px 32px 32px;background:var(--canvas-parchment);border-top:1px solid var(--hairline)}
.footer-inner{max-width:var(--max-w);margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px}
.footer-brand p{font-size:14px;color:var(--ink-muted);margin-top:8px;max-width:280px}
.footer-col h4{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;color:var(--ink-muted);margin-bottom:16px}
.footer-col a{display:block;font-size:14px;color:var(--ink-muted);text-decoration:none;margin-bottom:10px;transition:color .2s}
.footer-col a:hover{color:var(--primary)}
.footer-bottom{max-width:var(--max-w);margin:48px auto 0;padding-top:24px;border-top:1px solid var(--hairline);display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--ink-muted)}

/* ── Vulnerability Tabs ──────────────────────────────────── */
.vuln-tabs{display:flex;gap:8px;margin-top:32px;justify-content:center;flex-wrap:wrap}
.vuln-tab{padding:8px 20px;border-radius:var(--pill);font-size:14px;font-weight:600;border:1.5px solid var(--hairline);background:transparent;color:var(--ink-muted);cursor:pointer;transition:all .2s;font-family:var(--font)}
.vuln-tab:hover{border-color:var(--primary);color:var(--primary)}
.vuln-tab.active{background:var(--primary);color:#fff;border-color:var(--primary)}
.vuln-panel{display:none}
.vuln-panel.active{display:block}
.vuln-detail{margin-top:24px;background:var(--canvas);border:1px solid var(--hairline);border-radius:var(--radius-lg);padding:24px}
.vuln-detail-header{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.vuln-severity{font-size:11px;font-weight:700;padding:3px 10px;border-radius:var(--pill);text-transform:uppercase}
.vuln-severity-high{background:#fff0f0;color:#ff3b30}
.vuln-severity-medium{background:#fff8e1;color:#ff9500}
.vuln-severity-low{background:#f0fff4;color:#28c840}
.vuln-detail-title{font-size:16px;font-weight:600}
.vuln-detail-desc{font-size:14px;color:var(--ink-muted);line-height:1.6}

/* ── Scroll to Top ───────────────────────────────────────── */
.scroll-top{position:fixed;bottom:32px;right:32px;width:44px;height:44px;background:var(--primary);color:#fff;border:none;border-radius:50%;font-size:20px;cursor:pointer;box-shadow:var(--shadow-lg);opacity:0;transform:translateY(16px);transition:opacity .3s,transform .3s;z-index:999;display:flex;align-items:center;justify-content:center}
.scroll-top.visible{opacity:1;transform:translateY(0)}
.scroll-top:hover{background:var(--primary-focus);transform:translateY(-2px)}

/* ── Live Analyzer ───────────────────────────────────────── */
.analyzer-layout{display:grid;grid-template-columns:1fr 1fr;gap:32px;margin-top:48px}
.analyzer-input{background:var(--surface-darker);border-radius:var(--radius-lg);overflow:hidden}
.analyzer-input-header{display:flex;align-items:center;gap:8px;padding:12px 16px;background:rgba(0,0,0,.3);border-bottom:1px solid rgba(255,255,255,.05)}
.analyzer-input-header span{font-size:12px;color:rgba(255,255,255,.4);font-family:var(--font-mono)}
.analyzer-textarea{width:100%;min-height:280px;padding:16px;background:transparent;border:none;color:#e0e0e0;font-family:var(--font-mono);font-size:13px;line-height:1.6;resize:vertical;outline:none}
.analyzer-textarea::placeholder{color:#6e6e73}
.analyzer-btn{display:block;width:calc(100% - 32px);margin:0 16px 16px;padding:12px;background:var(--primary);color:#fff;border:none;border-radius:var(--pill);font-size:14px;font-weight:600;cursor:pointer;font-family:var(--font);transition:background .2s}
.analyzer-btn:hover{background:var(--primary-focus)}
.analyzer-btn:disabled{opacity:.5;cursor:not-allowed}
.analyzer-results{display:flex;flex-direction:column;gap:12px}
.analyzer-finding{background:var(--canvas);border:1px solid var(--hairline);border-radius:var(--radius-md);padding:16px;opacity:0;transform:translateX(12px);transition:opacity .3s,transform .3s}
.analyzer-finding.visible{opacity:1;transform:translateX(0)}
.analyzer-finding-header{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.analyzer-finding-line{font-size:12px;color:var(--ink-muted);font-family:var(--font-mono)}
.analyzer-finding-text{font-size:13px;line-height:1.5}
.analyzer-empty{color:var(--ink-muted);font-size:14px;text-align:center;padding:40px 0}

/* ── FAQ ─────────────────────────────────────────────────── */
.faq-item{background:var(--canvas);border:1px solid var(--hairline);border-radius:var(--radius-lg);overflow:hidden;transition:box-shadow .2s}
.faq-item:hover{box-shadow:var(--shadow)}
.faq-item[open]{box-shadow:var(--shadow)}
.faq-summary{padding:20px 24px;font-size:16px;font-weight:600;cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;transition:color .2s}
.faq-summary::-webkit-details-marker{display:none}
.faq-summary::after{content:'+';font-size:20px;color:var(--ink-muted);transition:transform .2s}
.faq-item[open] .faq-summary::after{transform:rotate(45deg)}
.faq-summary:hover{color:var(--primary)}
.faq-answer{padding:0 24px 20px;font-size:15px;line-height:1.6;color:var(--ink-muted)}

/* ── Pipeline Steps ──────────────────────────────────────── */
.pipeline-steps{display:flex;gap:16px;margin-top:48px;overflow-x:auto;padding-bottom:8px;scrollbar-width:none}
.pipeline-steps::-webkit-scrollbar{display:none}
.pipeline-step{flex:1;min-width:200px;background:var(--canvas);border:1px solid var(--hairline);border-radius:var(--radius-lg);padding:24px;text-align:center;transition:box-shadow .3s,transform .3s;position:relative}
.pipeline-step:hover{box-shadow:0 4px 24px rgba(0,102,204,.12);transform:translateY(-4px);border-color:rgba(0,102,204,.15)}
.pipeline-step-num{width:32px;height:32px;background:var(--primary);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;margin:0 auto 12px}
.pipeline-step-title{font-size:15px;font-weight:600;margin-bottom:6px}
.pipeline-step-desc{font-size:13px;color:var(--ink-muted);line-height:1.5}
.pipeline-arrow{display:flex;align-items:center;justify-content:center;color:var(--ink-muted);font-size:20px;flex-shrink:0;align-self:center}

/* ── CTA Banner ──────────────────────────────────────────── */
.cta-banner{background:linear-gradient(135deg,var(--primary) 0%,#004999 100%);border-radius:var(--radius-lg);padding:64px 48px;text-align:center;color:#fff;margin-top:48px}
.cta-banner .section-title{color:#fff}
.cta-banner .section-desc{color:rgba(255,255,255,.8);margin:0 auto 32px}
.cta-banner .btn-white{font-size:18px;padding:16px 36px}

/* ── Scroll Reveal ───────────────────────────────────────── */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease-out,transform .6s ease-out}
.reveal.in-view{opacity:1;transform:translateY(0)}
.stagger-item{opacity:0;transform:translateY(16px);transition:opacity .4s ease-out,transform .4s ease-out}
.stagger-item.in-view{opacity:1;transform:translateY(0)}

/* ── Responsive ──────────────────────────────────────────── */
@media(max-width:1068px){
  .feature-grid,.metric-grid{grid-template-columns:repeat(2,1fr)}
  .stats-row{grid-template-columns:repeat(2,1fr)}
  .knowledge-layout{grid-template-columns:1fr}
  .footer-inner{grid-template-columns:1fr 1fr}
}
@media(max-width:833px){
  .nav-links{gap:20px}
  .code-grid{grid-template-columns:1fr}
  .feature-grid,.metric-grid{grid-template-columns:1fr}
}
@media(max-width:640px){
  .section{padding:56px 20px}
  .hero{padding-top:100px}
  .nav{padding:0 16px}
  .nav-links{display:none}
  .hamburger{display:flex}
  .stats-row{grid-template-columns:repeat(2,1fr);gap:24px}
  .footer-inner{grid-template-columns:1fr}
  .footer-bottom{flex-direction:column;gap:8px;text-align:center}
  .pipeline-steps{flex-direction:column}
  .pipeline-step{min-width:unset}
}
@media print{
  .nav,.btn-report,.cursor,.scroll-top,.hamburger{display:none!important}
  .section{padding:40px 20px;break-inside:avoid}
  .reveal{opacity:1!important;transform:none!important}
  body{font-size:12px}
}

/* ── Hamburger Menu ──────────────────────────────────────── */
.hamburger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:4px;z-index:1001}
.hamburger span{width:22px;height:2px;background:var(--ink);border-radius:2px;transition:all .3s}
.hamburger.open span:nth-child(1){transform:rotate(45deg) translate(5px,5px)}
.hamburger.open span:nth-child(2){opacity:0}
.hamburger.open span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px)}
.mobile-menu{display:none;position:fixed;top:64px;left:0;right:0;background:rgba(255,255,255,.98);backdrop-filter:blur(20px);padding:24px 32px;border-bottom:1px solid var(--hairline);z-index:999;flex-direction:column;gap:16px}
.mobile-menu.open{display:flex}
.mobile-menu a{font-size:16px;font-weight:500;color:var(--ink);text-decoration:none;padding:8px 0;border-bottom:1px solid var(--hairline)}
.mobile-menu a:last-child{border-bottom:none}

/* ── Skip Link ──────────────────────────────────────────── */
.skip-link{position:absolute;top:-100%;left:16px;background:var(--primary);color:#fff;padding:8px 16px;border-radius:var(--radius-sm);z-index:10000;font-size:14px;font-weight:600;text-decoration:none}
.skip-link:focus{top:8px}

/* ── Copy Button ────────────────────────────────────────── */
.copy-btn{position:absolute;top:8px;right:8px;background:rgba(255,255,255,.1);color:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.1);border-radius:var(--radius-sm);padding:4px 10px;font-size:11px;font-family:var(--font);cursor:pointer;transition:all .2s}
.copy-btn:hover{background:rgba(255,255,255,.2);color:#fff}
.copy-btn.copied{background:rgba(40,200,64,.2);color:#28c840;border-color:rgba(40,200,64,.3)}
</style>
</head>
<body>

<!-- Skip to Content -->
