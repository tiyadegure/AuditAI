  <a href="https://github.com/tiyadegure/eth-beijing-2026" target="_blank">GitHub</a>
  <a href="index.html">English</a>
</div>

<!-- Hero -->
<section class="section hero section-center">
  <div class="section-inner section-narrow reveal">
    <div class="hero-badge">ETH Beijing 2026 · AI 智能体赛道</div>
    <h1 class="hero-title">智能合约安全，<br>重新定义。</h1>
    <p class="hero-subtitle">5 层 AI 代理，检测、验证、修补、链上证明 — 全自动完成。</p>
    <div class="btn-row">
      <a href="#demo" class="btn btn-primary">体验演示</a>
      <a href="https://github.com/tiyadegure/eth-beijing-2026" target="_blank" class="btn btn-outline">查看 GitHub</a>
    </div>
    <div class="stats-row">
      <div class="stat"><div class="stat-value">6,985</div><div class="stat-label">行 Python 代码</div></div>
      <div class="stat"><div class="stat-value">2,450</div><div class="stat-label">知识片段</div></div>
      <div class="stat"><div class="stat-value">477</div><div class="stat-label">审计报告</div></div>
      <div class="stat"><div class="stat-value">5</div><div class="stat-label">检测层</div></div>
    </div>
  </div>
</section>

<!-- Demo Section -->
<section id="demo" class="section section-dark">
  <div class="section-inner section-narrow section-center reveal">
    <h2 class="section-title">实时演示</h2>
    <p class="section-desc" style="margin:0 auto">观看 AuditAI 实时分析一个存在漏洞的智能合约。</p>
    <div class="terminal-wrapper">
      <div class="terminal">
        <div class="terminal-header">
          <span class="terminal-dot terminal-dot-r"></span>
          <span class="terminal-dot terminal-dot-y"></span>
          <span class="terminal-dot terminal-dot-g"></span>
          <span class="terminal-title">审计 — VulnerableBank.sol</span>
        </div>
        <div class="terminal-body" id="terminal"></div>
      </div>
      <button class="btn-report" id="btnReport" onclick="window.open('https://github.com/tiyadegure/eth-beijing-2026','_blank')">查看完整报告 →</button>
    </div>
  </div>
</section>

<!-- Detection Section -->
<section class="section section-center">
  <div class="section-inner section-narrow reveal">
    <h2 class="section-title">双引擎检测</h2>
    <p class="section-desc" style="margin:0 auto 0">Slither + Aderyn 交叉验证。LLM 通过 RAG 知识增强。8 个检测器家族，共识评分。</p>
    <div class="metric-grid">
      <div class="metric-card">
        <div class="metric-value">8</div>
        <div class="metric-label">检测器家族</div>
      </div>
      <div class="metric-card">
        <div class="metric-value">0.71</div>
        <div class="metric-label">召回率</div>
      </div>
      <div class="metric-card">
        <div class="metric-value">38</div>
        <div class="metric-label">次提交</div>
      </div>
    </div>
  </div>
</section>

<!-- Knowledge Section -->
<section class="section section-dark">
  <div class="section-inner section-narrow reveal">
    <h2 class="section-title section-center">477 Real 审计报告</h2>
    <p class="section-desc section-center" style="margin:0 auto 0">从 Solodit 知识库到向量索引。每一个漏洞模式，每一条攻击路径。</p>
    <div class="knowledge-layout">
      <div class="search-box">
        <span class="search-icon">⌕</span>
        <input type="text" class="search-input" id="ragInput" placeholder="搜索知识库...">
        <div class="search-results" id="ragResults"></div>
      </div>
      <div style="display:flex;flex-direction:column;gap:16px">
        <div class="feature-card">
          <div class="feature-icon">📚</div>
          <div class="feature-title">知识来源</div>
          <div class="feature-desc">477 篇 Solodit 报告 · 303 个漏洞参考 · EVMbench 模式</div>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔍</div>
          <div class="feature-title">向量搜索</div>
          <div class="feature-desc">ChromaDB + all-MiniLM-L6-v2 嵌入 · 语义相似度匹配</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Fuzzing Section -->
<section class="section section-parchment">
  <div class="section-inner section-narrow reveal">
    <h2 class="section-title section-center">从检测到证明</h2>
    <p class="section-desc section-center" style="margin:0 auto 0">Forge 不变性测试。生成漏洞 PoC。验证或证伪每个发现。</p>
    <div class="code-grid">
      <div class="code-card">
        <div class="code-header">
          <span class="code-icon">🔬</span>
          <span class="code-title">不变性模糊测试</span>
          <div class="code-stats">
            <span class="code-stat code-stat-pass">✓ 4</span>
            <span class="code-stat code-stat-fail">✕ 2</span>
            <span class="code-stat code-stat-timeout">⏱ 1</span>
          </div>
        </div>
        <div class="code-body">function testFuzz_deposit(uint256 amount) public {
    vm.assume(amount > 0 && amount <= MAX);
    bank.deposit{value: amount}();
    assertEq(bank.balances(user), amount);
}</div>
      </div>
      <div class="code-card">
        <div class="code-header">
          <span class="code-icon">💥</span>
          <span class="code-title">漏洞 PoC</span>
          <div class="code-stats">
            <span class="code-stat code-stat-pass">✓ 已验证</span>
          </div>
        </div>
        <div class="code-body">// Attack: reentrant withdraw
function attack() external {
    bank.deposit{value: 1 ether}();
    bank.withdraw(); // re-enters
    assertGt(address(this).balance, 1 ether);
}</div>
      </div>
    </div>
    <div class="vuln-tabs">
      <button class="vuln-tab active" data-vuln="reentrancy">重入攻击</button>
      <button class="vuln-tab" data-vuln="overflow">整数溢出</button>
      <button class="vuln-tab" data-vuln="access">访问控制</button>
      <button class="vuln-tab" data-vuln="oracle">预言机操控</button>
      <button class="vuln-tab" data-vuln="flashloan">闪电贷</button>
    </div>
    <div id="vulnPanel-reentrancy" class="vuln-detail vuln-panel active">
      <div class="vuln-detail-header">
        <span class="vuln-severity vuln-severity-high">高危</span>
        <span class="vuln-detail-title">withdraw() 重入漏洞</span>
      </div>
      <p class="vuln-detail-desc">withdraw() 函数在更新余额前发送 ETH，违反了 CEI 模式。攻击者可通过 fallback 函数重入以耗尽资金。由 Slither (reentrancy-eth) 检测，并由 Foundry 模糊测试确认。</p>
    </div>
    <div id="vulnPanel-overflow" class="vuln-detail vuln-panel">
      <div class="vuln-detail-header">
        <span class="vuln-severity vuln-severity-medium">中危</span>
        <span class="vuln-detail-title">余额计算整数溢出</span>
      </div>
      <p class="vuln-detail-desc">Solidity 0.8 之前的余额累加算术可能在大额存款时溢出。虽然 SafeMath 在新版本中缓解了此问题，但遗留合约仍然脆弱。由 Slither 检测并经目标模糊输入验证。</p>
    </div>
    <div id="vulnPanel-access" class="vuln-detail vuln-panel">
      <div class="vuln-detail-header">
        <span class="vuln-severity vuln-severity-high">高危</span>
        <span class="vuln-detail-title">缺少访问控制</span>
      </div>
      <p class="vuln-detail-desc">setOwner() 函数缺少任何修饰符，允许任何人获取所有权。与重入漏洞组合可创建关键攻击链。由 Aderyn 检测并通过 LLM 与 477 份审计报告的 RAG 知识交叉验证。</p>
    </div>
    <div id="vulnPanel-oracle" class="vuln-detail vuln-panel">
      <div class="vuln-detail-header">
        <span class="vuln-severity vuln-severity-medium">中危</span>
        <span class="vuln-detail-title">预言机价格操控</span>
      </div>
      <p class="vuln-detail-desc">DEX 储备的现货价格可在单笔交易内通过闪电互换操控。建议使用 TWAP 预言机（Chainlink、Uniswap V3 TWAP）。模式从 Solodit 知识库以 0.89 相似度匹配。</p>
    </div>
    <div id="vulnPanel-flashloan" class="vuln-detail vuln-panel">
      <div class="vuln-detail-header">
        <span class="vuln-severity vuln-severity-high">高危</span>
        <span class="vuln-detail-title">闪电贷攻击向量</span>
      </div>
      <p class="vuln-detail-desc">deposit() 接受任意代币数量而不验证调用者实际余额。闪电贷可膨胀合约感知的 TVL。建议：使用 permit + transferFrom 并进行余额检查。通过 RAG 检索匹配 EVMbench 模式发现。</p>
    </div>
  </div>
</section>

<!-- Resilience Section -->
<section class="section section-center">
  <div class="section-inner section-narrow reveal">
    <h2 class="section-title">韧性设计</h2>
    <p class="section-desc" style="margin:0 auto 0">检查点恢复。MCP 集成。多策略分析。</p>
    <div class="feature-grid">
      <div class="feature-card">
        <div class="feature-icon">🛡️</div>
        <div class="feature-title">崩溃恢复</div>
        <div class="feature-desc">每步保存检查点。使用 --resume 标志续跑。永不丢失进度。</div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🔌</div>
        <div class="feature-title">MCP 服务器</div>
        <div class="feature-desc">通过 Model Context Protocol 暴露审计工具给 IDE 和代理集成。</div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🎯</div>
        <div class="feature-title">多策略分析</div>
        <div class="feature-desc">广度分析 + 深度分析。BA 发现通用问题，TA 针对特定模式。</div>
      </div>
    </div>
  </div>
</section>

<!-- Attestation Section -->
<section class="section section-dark section-center">
  <div class="section-inner section-narrow reveal">
    <h2 class="section-title">审计结果，链上存证</h2>
    <p class="section-desc" style="margin:0 auto 0">EAS Sepolia 链上证明。可验证凭证。透明度由设计保障。</p>
    <div class="attestation">
      <div class="att-row"><span class="att-key">Network</span><span class="att-value">Sepolia 测试网</span></div>
      <div class="att-row"><span class="att-key">Transaction</span><span class="att-value">0xabc1…def9</span></div>
      <div class="att-row"><span class="att-key">Schema</span><span class="att-value">0x736e…a1b2</span></div>
      <div class="att-row"><span class="att-key">Contract</span><span class="att-value">VulnerableBank.sol</span></div>
      <div class="att-row"><span class="att-key">漏洞数量</span><span class="att-value">发现 8 个</span></div>
      <div class="att-row"><span class="att-key">安全评分</span><span class="att-value">32 / 100</span></div>
      <div class="att-row"><span class="att-key">证明者</span><span class="att-value">0xAud1…t0r5</span></div>
    </div>
  </div>
</section>

<!-- How It Works -->
<section class="section section-parchment">
  <div class="section-inner section-narrow section-center reveal">
    <h2 class="section-title">工作流程</h2>
    <p class="section-desc" style="margin:0 auto 0">五层架构。一条命令。完整安全分析。</p>
    <div class="pipeline-steps">
      <div class="pipeline-step">
        <div class="pipeline-step-num">1</div>
        <div class="pipeline-step-title">解析</div>
        <div class="pipeline-step-desc">解析 Solidity 源码。构建 AST。提取函数和状态变量。</div>
      </div>
      <div class="pipeline-arrow">→</div>
      <div class="pipeline-step">
        <div class="pipeline-step-num">2</div>
        <div class="pipeline-step-title">检测</div>
        <div class="pipeline-step-desc">运行 Slither + Aderyn。交叉验证结果。LLM 通过 RAG 增强。</div>
      </div>
      <div class="pipeline-arrow">→</div>
      <div class="pipeline-step">
        <div class="pipeline-step-num">3</div>
        <div class="pipeline-step-title">验证</div>
        <div class="pipeline-step-desc">生成 Foundry 模糊测试。证明或证伪每个漏洞。</div>
      </div>
      <div class="pipeline-arrow">→</div>
      <div class="pipeline-step">
        <div class="pipeline-step-num">4</div>
        <div class="pipeline-step-title">修补</div>
        <div class="pipeline-step-desc">自动生成修复。验证补丁编译。应用安全模式。</div>
      </div>
      <div class="pipeline-arrow">→</div>
      <div class="pipeline-step">
        <div class="pipeline-step-num">5</div>
        <div class="pipeline-step-title">存证</div>
        <div class="pipeline-step-desc">创建 EAS 链上证明。发布可验证审计凭证。</div>
      </div>
    </div>
  </div>
</section>

<!-- Comparison Section -->
<section class="section">
  <div class="section-inner section-narrow reveal">
    <h2 class="section-title section-center">为什么选择 AuditAI？</h2>
    <p class="section-desc section-center" style="margin:0 auto 32px">看看我们与传统安全工具的对比。</p>
    <div class="attestation">
      <div class="att-row" style="font-weight:600;background:var(--canvas-parchment)">
        <span class="att-key">功能</span>
        <span class="att-value" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;text-align:center">
          <span>AuditAI</span><span>Slither</span><span>人工审计</span>
        </span>
      </div>
      <div class="att-row">
        <span class="att-key">自动化检测</span>
        <span class="att-value" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;text-align:center">
          <span style="color:#28c840">✓</span><span style="color:#28c840">✓</span><span style="color:#ff5f57">✕</span>
        </span>
      </div>
      <div class="att-row">
        <span class="att-key">LLM 增强</span>
        <span class="att-value" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;text-align:center">
          <span style="color:#28c840">✓</span><span style="color:#ff5f57">✕</span><span style="color:#28c840">✓</span>
        </span>
      </div>
      <div class="att-row">
        <span class="att-key">PoC 生成</span>
        <span class="att-value" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;text-align:center">
          <span style="color:#28c840">✓</span><span style="color:#ff5f57">✕</span><span style="color:#28c840">✓</span>
        </span>
      </div>
      <div class="att-row">
        <span class="att-key">链上证明</span>
        <span class="att-value" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;text-align:center">
          <span style="color:#28c840">✓</span><span style="color:#ff5f57">✕</span><span style="color:#ff5f57">✕</span>
        </span>
      </div>
      <div class="att-row">
        <span class="att-key">速度</span>
        <span class="att-value" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;text-align:center">
          <span>~5 分钟</span><span>~30 秒</span><span>~1 周</span>
        </span>
      </div>
      <div class="att-row">
        <span class="att-key">成本</span>
