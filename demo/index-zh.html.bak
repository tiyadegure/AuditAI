<!-- Gallery Section -->
<section class="section">
  <div class="section-inner section-narrow section-center reveal">
    <h2 class="section-title">API 参考</h2>
    <p class="section-desc" style="margin:0 auto 32px">以编程方式访问所有 AuditAI 功能。</p>
    <div class="code-grid">
      <div class="code-card">
        <div class="code-header">
          <span class="code-icon">🐍</span>
          <span class="code-title">Python SDK</span>
        </div>
        <div class="code-body">from auditai import AuditAI

client = AuditAI(api_key="YOUR_KEY")
result = client.audit("contract.sol")
print(result.vulnerabilities)
print(result.score)</div>
      </div>
      <div class="code-card">
        <div class="code-header">
          <span class="code-icon">🔌</span>
          <span class="code-title">MCP 服务器</span>
        </div>
        <div class="code-body"># 启动 MCP 服务器
auditai serve --port 3000

# 可用工具：
# - audit_contract
# - search_knowledge
# - generate_report
# - create_attestation</div>
      </div>
    </div>
  </div>
</section>

<!-- Security Policy Section -->
<section class="section section-parchment">
  <div class="section-inner section-narrow section-center reveal">
    <h2 class="section-title">安全策略</h2>
    <p class="section-desc" style="margin:0 auto 32px">我们如何处理 AuditAI 自身的安全漏洞。</p>
    <div class="attestation" style="max-width:640px;margin:0 auto">
      <div class="att-row">
        <span class="att-key">报告方式</span>
        <span class="att-value">security@auditai.dev（提供 PGP 密钥）</span>
      </div>
      <div class="att-row">
        <span class="att-key">响应时间</span>
        <span class="att-value">关键 48 小时，其他 7 天</span>
      </div>
      <div class="att-row">
        <span class="att-key">披露政策</span>
        <span class="att-value">修复发布后协调披露</span>
      </div>
      <div class="att-row">
        <span class="att-key">漏洞赏金</span>
        <span class="att-value">关键漏洞最高 $500</span>
      </div>
    </div>
  </div>
</section>

<!-- Gallery Section -->
<section class="section">
  <div class="section-inner section-narrow section-center reveal">
    <h2 class="section-title">配置选项</h2>
    <p class="section-desc" style="margin:0 auto 32px">自定义 AuditAI 以适应您的工作流。</p>
    <div class="attestation" style="max-width:720px;margin:0 auto">
      <div class="att-row">
        <span class="att-key">auditai.api_key</span>
        <span class="att-value">MiMo API 密钥用于 LLM 分析</span>
      </div>
      <div class="att-row">
        <span class="att-key">auditai.mode</span>
        <span class="att-value">all | targeted | broad（默认：all）</span>
      </div>
      <div class="att-row">
        <span class="att-key">auditai.engines</span>
        <span class="att-value">slither,aderyn,llm（逗号分隔）</span>
      </div>
      <div class="att-row">
        <span class="att-key">auditai.output</span>
        <span class="att-value">json | markdown | html（默认：markdown）</span>
      </div>
      <div class="att-row">
        <span class="att-key">auditai.attestation</span>
        <span class="att-value">true | false（默认：true）</span>
      </div>
      <div class="att-row">
        <span class="att-key">auditai.network</span>
        <span class="att-value">sepolia | mainnet（默认：sepolia）</span>
      </div>
    </div>
  </div>
</section>

<!-- Troubleshooting Section -->
<section class="section section-dark">
  <div class="section-inner section-narrow section-center reveal">
    <h2 class="section-title">故障排除</h2>
    <p class="section-desc" style="margin:0 auto 32px">常见问题及其解决方案。</p>
    <div style="max-width:720px;margin:48px auto 0;display:flex;flex-direction:column;gap:16px">
      <details class="faq-item" style="background:var(--surface-darker);border-color:rgba(255,255,255,.08)">
        <summary class="faq-summary" style="color:#fff">Slither 未找到错误</summary>
        <p class="faq-answer" style="color:rgba(255,255,255,.6)">安装 Slither：pip install slither-analyzer。确保 solc 在 PATH 中。</p>
      </details>
      <details class="faq-item" style="background:var(--surface-darker);border-color:rgba(255,255,255,.08)">
        <summary class="faq-summary" style="color:#fff">API 密钥无效</summary>
        <p class="faq-answer" style="color:rgba(255,255,255,.6)">在 platform.auditai.dev 检查 API 密钥。确保配置中没有多余空格。</p>
      </details>
      <details class="faq-item" style="background:var(--surface-darker);border-color:rgba(255,255,255,.08)">
        <summary class="faq-summary" style="color:#fff">证明失败</summary>
        <p class="faq-answer" style="color:rgba(255,255,255,.6)">确保有 Sepolia ETH。从 sepoliafaucet.com 获取测试网 ETH。</p>
      </details>
    </div>
  </div>
</section>

