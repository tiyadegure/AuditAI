<!-- Scroll to Top -->
<button class="scroll-top" id="scrollTop" aria-label="回到顶部">↑</button>

<script>
// Terminal typewriter
const lines=[
  {t:'$ python3 -m src.main audit VulnerableBank.sol --mode all',c:'t-cmd'},
  {t:'',c:''},
  {t:'🔍 Running Slither... 5 findings',c:'t-info'},
  {t:'🔍 Running Aderyn... 14 findings',c:'t-info'},
  {t:'🧠 LLM Analysis... 3 findings',c:'t-info'},
  {t:'📚 RAG Retrieval... 2,450 chunks scanned',c:'t-dim'},
  {t:'🔄 Merging results... 8 unique vulnerabilities',c:''},
  {t:'✅ Confidence scoring... 4 high, 3 medium, 1 low',c:'t-ok'},
  {t:'🛡️ Checkpoint saved',c:'t-dim'},
  {t:'🔧 Generating patches... 5/5 successful',c:'t-ok'},
  {t:'🔗 EAS 证明... tx: 0xabc...def',c:'t-dim'},
  {t:'✅ Audit complete. Report saved.',c:'t-ok'}
];
const term=document.getElementById('terminal');
const btn=document.getElementById('btnReport');
let idx=0;
function addLine(){
  if(idx>=lines.length){btn.classList.add('visible');updateProgress(100);return}
  const d=document.createElement('div');
  d.className='terminal-line';
  d.innerHTML=`<span class="${lines[idx].c}">${lines[idx].t}</span><span class="cursor"></span>`;
  term.appendChild(d);
  setTimeout(()=>d.classList.add('visible'),50);
  updateProgress(Math.round((idx/lines.length)*100));
  setTimeout(()=>{const c=d.querySelector('.cursor');if(c)c.remove();idx++;addLine()},180);
}
function updateProgress(pct){
  let bar=document.getElementById('termProgress');
  if(!bar){bar=document.createElement('div');bar.id='termProgress';bar.style.cssText='height:3px;background:rgba(255,255,255,.08);position:absolute;bottom:0;left:0;right:0;overflow:hidden';bar.innerHTML='<div style="height:100%;background:var(--primary-on-dark);transition:width .3s;width:0%" id="termBar"></div>';term.parentElement.style.position='relative';term.parentElement.appendChild(bar)}
  document.getElementById('termBar').style.width=pct+'%';
}
const heroObs=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting&&idx===0){addLine();heroObs.unobserve(x.target)}})},{threshold:.3});
heroObs.observe(document.getElementById('terminal'));

// RAG search
const inp=document.getElementById('ragInput');
const res=document.getElementById('ragResults');
let tmr;
const data=[
  {t:'Reentrancy in withdraw() — no CEI pattern...',s:0.94,y:'solodit'},
  {t:'Oracle price manipulation via spot price...',s:0.89,y:'solodit'},
  {t:'Access control missing in setOwner()...',s:0.87,y:'vulnerability_reference'},
  {t:'Flash loan attack vector in deposit()...',s:0.82,y:'solodit'},
  {t:'Integer overflow in balance calculation...',s:0.79,y:'vulnerability_reference'}
];
inp.addEventListener('input',()=>{clearTimeout(tmr);res.innerHTML='';if(inp.value.length<2)return;tmr=setTimeout(()=>{data.forEach((x,i)=>{const d=document.createElement('div');d.className='search-result';d.innerHTML=`<div class="search-result-header"><span class="search-result-type">${x.y}</span><span class="search-result-score">Score: ${x.s}</span></div><div class="search-result-text">${x.t}</div>`;res.appendChild(d);setTimeout(()=>d.classList.add('visible'),i*100+100)})},300)});

// Scroll reveal + stagger
const obs=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('in-view');if(x.target.classList.contains('stagger-parent')){x.target.querySelectorAll('.stagger-item').forEach((item,i)=>{setTimeout(()=>item.classList.add('in-view'),i*100)})}}})},{threshold:.12});
document.querySelectorAll('.reveal,.stagger-item').forEach(el=>obs.observe(el));
document.querySelectorAll('.feature-grid,.metric-grid,.code-grid,.pipeline-steps').forEach(g=>g.classList.add('stagger-parent'));
document.querySelectorAll('.feature-grid>.feature-card,.metric-grid>.metric-card,.code-grid>.code-card,.pipeline-steps>.pipeline-step').forEach(el=>el.classList.add('stagger-item'));

// Syntax highlighting for code blocks
function highlightSolidity(code){
  const kw=['function','public','external','private','internal','view','pure','returns','uint256','uint','int','address','bool','string','bytes','mapping','struct','enum','event','modifier','if','else','for','while','return','require','assert','revert','emit','new','delete','true','false','msg','block','tx','this','super','pragma','import','contract','library','interface','is','abstract','virtual','override','payable','memory','storage','calldata'];
  let h=code.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  h=h.replace(/(\/\/[^\n]*)/g,'<span class="cm">$1</span>');
  h=h.replace(/('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*")/g,'<span class="str">$1</span>');
  h=h.replace(/\b(0x[0-9a-fA-F]+|\d+)\b/g,'<span class="num">$1</span>');
  kw.forEach(k=>{h=h.replace(new RegExp('\\b('+k+')\\b','g'),'<span class="kw">$1</span>')});
  h=h.replace(/\b([a-zA-Z_]\w*)\s*(?=\()/g,'<span class="fn">$1</span>');
  return h;
}
document.querySelectorAll('.code-body').forEach(block=>{
  const raw=block.textContent;
  if(raw.includes('function')||raw.includes('testFuzz')||raw.includes('//')){
    const btn=block.querySelector('.copy-btn');
    block.innerHTML=highlightSolidity(raw);
    if(btn)block.appendChild(btn);
  }
});

// Vulnerability tabs
document.querySelectorAll('.vuln-tab').forEach(tab=>{
  tab.addEventListener('click',()=>{
    document.querySelectorAll('.vuln-tab').forEach(t=>t.classList.remove('active'));
    document.querySelectorAll('.vuln-panel').forEach(p=>p.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('vulnPanel-'+tab.dataset.vuln).classList.add('active');
  });
});

// Scroll to top
const scrollTopBtn=document.getElementById('scrollTop');
window.addEventListener('scroll',()=>{
  scrollTopBtn.classList.toggle('visible',window.scrollY>600);
},{passive:true});
scrollTopBtn.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));

// Hamburger menu
const hamburger=document.getElementById('hamburger');
const mobileMenu=document.getElementById('mobileMenu');
hamburger.addEventListener('click',()=>{hamburger.classList.toggle('open');mobileMenu.classList.toggle('open')});
mobileMenu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{hamburger.classList.remove('open');mobileMenu.classList.remove('open')}));

// Copy code buttons
document.querySelectorAll('.code-body').forEach(block=>{
  const btn=document.createElement('button');
  btn.className='copy-btn';btn.textContent='复制';btn.setAttribute('aria-label','复制代码');
  btn.addEventListener('click',()=>{
    navigator.clipboard.writeText(block.textContent).then(()=>{btn.textContent='已复制!';btn.classList.add('copied');setTimeout(()=>{btn.textContent='复制';btn.classList.remove('copied')},2000)});
  });
  block.appendChild(btn);
});

// Keyboard shortcuts
document.addEventListener('keydown',e=>{
  if(e.key==='k'&&!e.metaKey&&!e.ctrlKey&&document.activeElement.tagName!=='INPUT'){
    e.preventDefault();
    document.getElementById('ragInput').focus();
    window.scrollTo({top:document.getElementById('ragInput').getBoundingClientRect().top+window.scrollY-100,behavior:'smooth'});
  }
  if(e.key==='Escape')document.activeElement.blur();
});

// Counter animation for stat values
function animateCounters(){
  document.querySelectorAll('.stat-value').forEach(el=>{
    const target=el.textContent.replace(/,/g,'');
    if(isNaN(target))return;
    const end=parseInt(target);
    const duration=1500;
    const start=performance.now();
    function step(now){
      const progress=Math.min((now-start)/duration,1);
      const eased=1-Math.pow(1-progress,3);
      el.textContent=Math.floor(end*eased).toLocaleString();
      if(progress<1)requestAnimationFrame(step);
      else el.textContent=end.toLocaleString();
    }
    requestAnimationFrame(step);
  });
}
const statsObs=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting){animateCounters();statsObs.unobserve(x.target)}})},{threshold:.3});
document.querySelectorAll('.stats-row').forEach(el=>statsObs.observe(el));

// Live analyzer
const analyzeBtn=document.getElementById('analyzeBtn');
const analyzerResults=document.getElementById('analyzerResults');
if(analyzeBtn){
  const findings=[
    {severity:'high',sevLabel:'高危',title:'withdraw() 重入漏洞',desc:'在更新状态前发送 ETH，违反 CEI 模式。',line:'第 7-9 行'},
    {severity:'high',sevLabel:'高危',title:'setOwner() 缺少访问控制',desc:'任何人可以更改合约所有权。无修饰符保护。',line:'第 17 行'},
    {severity:'medium',sevLabel:'中危',title:'未检查低级调用',desc:'.call() 的返回值应该检查失败情况。',line:'第 8 行'},
    {severity:'low',sevLabel:'低危',title:'缺少事件发射',desc:'状态变更应该发射事件以便链下追踪。',line:'第 12, 17 行'}
  ];
  analyzeBtn.addEventListener('click',()=>{
    analyzerResults.innerHTML='';
    analyzeBtn.disabled=true;
    analyzeBtn.textContent='分析中...';
    findings.forEach((f,i)=>{
      setTimeout(()=>{
        const d=document.createElement('div');
        d.className='analyzer-finding';
        d.innerHTML=`<div class="analyzer-finding-header"><span class="vuln-severity vuln-severity-${f.severity}">${f.sevLabel}</span><span class="vuln-detail-title">${f.title}</span><span class="analyzer-finding-line">${f.line}</span></div><div class="analyzer-finding-text">${f.desc}</div>`;
        analyzerResults.appendChild(d);
        setTimeout(()=>d.classList.add('visible'),50);
        if(i===findings.length-1){analyzeBtn.disabled=false;analyzeBtn.textContent='🔍 分析合约'}
      },(i+1)*600);
    });
  });
}
</script>

</body>
</html>
