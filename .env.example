# AuditAI Configuration

# MiMo API (required)
MIMO_API_KEY=your_mimo_api_key_here
MIMO_API_URL=https://api.volcengine.com/v3/chat/completions

# Ethereum (for EAS attestation)
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=your_private_key_here

# EAS Contract Addresses (Sepolia testnet)
EAS_CONTRACT_ADDRESS=0xC2679fBD37d54388Ce493F1DB75320D236e1815e
EAS_SCHEMA_REGISTRY=0x0a7E2Ff94F0Dca2a84c7De48e8E6f7a2999c7dfc

# Knowledge Base
KNOWLEDGE_BASE_PATH=./data/knowledge-base

# Output
OUTPUT_DIR=./output/reports

# Optional: Slither
SLITHER_CONFIG=slither.config.json

# Optional: Logging
LOG_LEVEL=INFO
